<Window x:Class="DiskMonitor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Monitor"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border x:Name="RootBorder" Padding="20,24,20,16">
        <StackPanel>
            <Button x:Name="LogoButton"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    Focusable="False"
                    Click="LogoButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Button.Template>
                <Image x:Name="LogoImage"
                       Height="34"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>

            <TextBlock x:Name="AppNameText"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Text="Disk Monitor" />

            <TextBlock x:Name="DetailText"
                       TextWrapping="Wrap"
                       LineHeight="18.85" />

            <StackPanel Margin="0,18,0,0">
                <Button x:Name="IntroButton"
                        MinHeight="28"
                        Margin="0,0,0,8"
                        Padding="10,4"
                        Click="IntroButton_Click" />
                <Button x:Name="OkButton"
                        MinHeight="28"
                        Padding="10,4"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
